// ==============================================================================
// MedCore HMS — Comprehensive PostgreSQL Database Schema (Prisma ORM)
// ==============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  LAB_TECHNICIAN
  PHARMACIST
  ACCOUNTANT
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  REGULAR
  FOLLOW_UP
  EMERGENCY
}

enum EncounterStatus {
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DiagnosisType {
  PROVISIONAL
  CONFIRMED
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

enum AmendmentType {
  ADDENDUM
  CORRECTION
  LATE_ENTRY
}

enum AmendmentSection {
  CLINICAL_NOTES
  DIAGNOSIS
  TREATMENT_PLAN
  OTHER
}

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  TOPICAL
  DROPS
  INHALER
  OTHER
}

enum PrescriptionFrequency {
  OD
  BD
  TDS
  QID
  PRN
  SOS
  STAT
}

enum PrescriptionStatus {
  ISSUED
  DISPENSED
  CANCELLED
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum InvoiceItemType {
  CONSULTATION
  LAB_TEST
  PHARMACY
  PROCEDURE
  ROOM
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  STRIPE
  RAZORPAY
  BANK_TRANSFER
  INSURANCE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VIEW_CONFIDENTIAL
  EXPORT
}

// ------------------------------------------------------------------------------
// CORE TENANCY & IDENTITY
// ------------------------------------------------------------------------------

model Address {
  id          String     @id @default(uuid())
  street      String
  city        String
  state       String
  postalCode  String
  country     String     @default("India")
  hospitals   Hospital[]
  patients    Patient[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Hospital {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  code             String            @unique
  email            String
  phone            String
  website          String?
  logoUrl          String?
  status           String            @default("ACTIVE")
  subscriptionTier String            @default("STANDARD")
  addressId        String?
  address          Address?          @relation(fields: [addressId], references: [id])
  settings         Json?

  users            User[]
  departments      Department[]
  doctors          Doctor[]
  patients         Patient[]
  appointments     Appointment[]
  encounters       PatientEncounter[]
  medicalRecords   MedicalRecord[]
  prescriptions    Prescription[]
  medicines        Medicine[]
  labCategories    LabCategory[]
  labTests         LabTest[]
  labOrders        LabOrder[]
  invoices         Invoice[]
  auditLogs        AuditLog[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
}

model User {
  id              String           @id @default(uuid())
  hospitalId      String?
  hospital        Hospital?        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  email           String           @unique
  supabaseAuthId  String?          @unique
  passwordHash    String
  role            Role
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  isEmailVerified Boolean          @default(false)
  isPhoneVerified Boolean          @default(false)
  isActive        Boolean          @default(true)

  doctorProfile   Doctor?
  patientProfile  Patient?
  refreshSessions RefreshSession[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([hospitalId, role])
}

model RefreshSession {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  deviceId     String
  userAgent    String?
  ipAddress    String?
  isRevoked    Boolean   @default(false)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, deviceId])
}

// ------------------------------------------------------------------------------
// DEPARTMENTS & CLINICIANS
// ------------------------------------------------------------------------------

model Department {
  id           String        @id @default(uuid())
  hospitalId   String
  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name         String
  code         String
  description  String?
  headDoctorId String?
  isActive     Boolean       @default(true)

  doctors      Doctor[]
  appointments Appointment[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([hospitalId, code])
  @@index([hospitalId])
}

model Doctor {
  id              String               @id @default(uuid())
  userId          String               @unique
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId      String
  hospital        Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department           @relation(fields: [departmentId], references: [id])
  specialization  String
  licenseNumber   String
  consultationFee Decimal              @default(50.00) @db.Decimal(10, 2)
  bio             String?
  signatureUrl    String?
  isAvailable     Boolean              @default(true)

  availability    DoctorAvailability[]
  leaves          DoctorLeave[]
  appointments    Appointment[]
  encounters      PatientEncounter[]
  medicalRecords  MedicalRecord[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  amendments      MedicalRecordAmendment[]

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  @@index([hospitalId, departmentId])
}

model DoctorAvailability {
  id                  String   @id @default(uuid())
  doctorId            String
  doctor              Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek           Int      // 0 = Sun, 1 = Mon, ..., 6 = Sat
  startTime           String   // e.g. "09:00"
  endTime             String   // e.g. "17:00"
  slotDurationMinutes Int      @default(30)
  maxBookingsPerSlot  Int      @default(1)
  isActive            Boolean  @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([doctorId, dayOfWeek])
}

model DoctorLeave {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, startDate])
}

// ------------------------------------------------------------------------------
// PATIENTS & SCHEDULING
// ------------------------------------------------------------------------------

model Patient {
  id                      String             @id @default(uuid())
  userId                  String             @unique
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId              String
  hospital                Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  uhid                    String             // Unique Hospital ID
  dateOfBirth             DateTime
  gender                  Gender
  bloodGroup              BloodGroup?
  addressId               String?
  address                 Address?           @relation(fields: [addressId], references: [id])
  emergencyContactName    String?
  emergencyContactPhone   String?
  emergencyContactRelation String?
  allergiesSummary        String?

  appointments            Appointment[]
  encounters              PatientEncounter[]
  medicalRecords          MedicalRecord[]
  prescriptions           Prescription[]
  labOrders               LabOrder[]
  invoices                Invoice[]
  allergies               Allergy[]
  vaccinations            VaccinationHistory[]
  familyHistories         FamilyHistory[]
  medicationHistories     MedicationHistory[]

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  deletedAt               DateTime?

  @@unique([hospitalId, uhid])
  @@index([hospitalId])
}

model Appointment {
  id                 String            @id @default(uuid())
  hospitalId         String
  hospital           Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department        @relation(fields: [departmentId], references: [id])
  appointmentDate    DateTime
  startTime          String            // "09:30"
  endTime            String            // "10:00"
  status             AppointmentStatus @default(PENDING)
  type               AppointmentType   @default(REGULAR)
  reason             String?
  notes              String?
  cancellationReason String?

  encounter          PatientEncounter?
  invoice            Invoice?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  @@index([hospitalId, appointmentDate])
  @@index([doctorId, appointmentDate])
  @@index([patientId, appointmentDate])
}

// ------------------------------------------------------------------------------
// CLINICAL ENCOUNTERS & EMR
// ------------------------------------------------------------------------------

model PatientEncounter {
  id            String          @id @default(uuid())
  hospitalId    String
  hospital      Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointmentId String          @unique
  appointment   Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  status        EncounterStatus @default(CHECKED_IN)
  startedAt     DateTime?
  completedAt   DateTime?

  medicalRecord MedicalRecord?
  prescription  Prescription?
  labOrders     LabOrder[]
  invoice       Invoice?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([hospitalId, patientId])
  @@index([hospitalId, doctorId])
}

model MedicalRecord {
  id                 String           @id @default(uuid())
  hospitalId         String
  hospital           Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  encounterId        String           @unique
  encounter          PatientEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId          String
  patient            Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  chiefComplaint     String
  presentingSymptoms String?
  clinicalNotes      String?
  treatmentPlan      String?
  followUpDate       DateTime?

  vitals             Vital[]
  diagnoses          Diagnosis[]
  allergies          Allergy[]
  attachments        Attachment[]
  amendments         MedicalRecordAmendment[]
  vaccinations       VaccinationHistory[]
  familyHistories    FamilyHistory[]
  medicationHistories MedicationHistory[]

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([hospitalId, patientId])
}

model Vital {
  id              String        @id @default(uuid())
  recordId        String
  record          MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  recordedAt      DateTime      @default(now())
  bpSystolic      Int?
  bpDiastolic     Int?
  heartRate       Int?
  temperature     Decimal?      @db.Decimal(4, 1)
  spo2            Int?
  respiratoryRate Int?
  heightCm        Decimal?      @db.Decimal(5, 2)
  weightKg        Decimal?      @db.Decimal(5, 2)
  bmi             Decimal?      @db.Decimal(4, 1)
  notes           String?

  createdAt       DateTime      @default(now())

  @@index([recordId])
}

model Diagnosis {
  id          String        @id @default(uuid())
  recordId    String
  record      MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  code        String?       // ICD-10
  description String
  type        DiagnosisType @default(CONFIRMED)
  isPrimary   Boolean       @default(true)
  notes       String?

  createdAt   DateTime      @default(now())

  @@index([recordId])
}

model Allergy {
  id          String         @id @default(uuid())
  recordId    String?
  record      MedicalRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  patientId   String
  patient     Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergen    String
  reaction    String
  severity    AllergySeverity @default(MODERATE)
  diagnosedAt DateTime       @default(now())

  createdAt   DateTime       @default(now())

  @@index([patientId])
}

model Attachment {
  id         String        @id @default(uuid())
  recordId   String
  record     MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedAt DateTime      @default(now())

  @@index([recordId])
}

model VaccinationHistory {
  id               String         @id @default(uuid())
  patientId        String
  patient          Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordId         String?
  record           MedicalRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  vaccineName      String
  administeredDate DateTime
  batchNumber      String?
  nextDueDate      DateTime?
  notes            String?
  createdAt        DateTime       @default(now())

  @@index([patientId])
}

model FamilyHistory {
  id           String         @id @default(uuid())
  patientId    String
  patient      Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordId     String?
  record       MedicalRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  condition    String         // e.g. "Diabetes", "Hypertension", "Cancer", "Cardiac"
  relationship String         // e.g. "Father", "Mother", "Sibling", "Grandparent"
  notes        String?
  createdAt    DateTime       @default(now())

  @@index([patientId])
}

model MedicationHistory {
  id             String         @id @default(uuid())
  patientId      String
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordId       String?
  record         MedicalRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  medicationName String
  dosage         String         // e.g. "500mg"
  frequency      String         // e.g. "Once daily", "BD"
  route          String?        // e.g. "Oral"
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean        @default(true)
  notes          String?
  createdAt      DateTime       @default(now())

  @@index([patientId])
}

model MedicalRecordAmendment {
  id              String           @id @default(uuid())
  recordId        String
  record          MedicalRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  amendedById     String
  amendedBy       Doctor           @relation(fields: [amendedById], references: [id], onDelete: Cascade)
  amendmentNumber Int
  amendmentType   AmendmentType    @default(ADDENDUM)
  section         AmendmentSection @default(CLINICAL_NOTES)
  reason          String
  content         String
  createdAt       DateTime         @default(now())

  @@index([recordId])
}

// ------------------------------------------------------------------------------
// PRESCRIPTIONS & PHARMACY
// ------------------------------------------------------------------------------

model Prescription {
  id           String             @id @default(uuid())
  hospitalId   String
  hospital     Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  encounterId  String             @unique
  encounter    PatientEncounter   @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String
  doctor       Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  notes        String?
  signedPdfUrl String?
  status       PrescriptionStatus @default(ISSUED)

  items        PrescriptionItem[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([hospitalId, patientId])
}

model PrescriptionItem {
  id                String                @id @default(uuid())
  prescriptionId    String
  prescription      Prescription          @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId        String
  medicine          Medicine              @relation(fields: [medicineId], references: [id])
  dosage            String
  frequency         PrescriptionFrequency @default(BD)
  durationDays      Int                   @default(5)
  route             String                @default("ORAL")
  instructions      String?
  dispensedQuantity Int                   @default(0)

  createdAt         DateTime              @default(now())

  @@index([prescriptionId])
}

model Medicine {
  id                String             @id @default(uuid())
  hospitalId        String
  hospital          Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name              String
  genericName       String
  category          String
  form              MedicineForm       @default(TABLET)
  strength          String
  manufacturer      String
  reorderLevel      Int                @default(100)

  batches           MedicineBatch[]
  prescriptionItems PrescriptionItem[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([hospitalId, name])
  @@index([hospitalId, category])
}

model MedicineBatch {
  id                String   @id @default(uuid())
  medicineId        String
  medicine          Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNumber       String
  manufacturingDate DateTime
  expiryDate        DateTime
  initialQuantity   Int
  currentQuantity   Int
  unitCost          Decimal  @db.Decimal(10, 2)
  mrp               Decimal  @db.Decimal(10, 2)
  isQuarantined     Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([medicineId, batchNumber])
  @@index([medicineId, expiryDate])
}

// ------------------------------------------------------------------------------
// LABORATORY
// ------------------------------------------------------------------------------

model LabCategory {
  id         String    @id @default(uuid())
  hospitalId String
  hospital   Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name       String
  tests      LabTest[]

  createdAt  DateTime  @default(now())

  @@unique([hospitalId, name])
}

model LabTest {
  id                String         @id @default(uuid())
  hospitalId        String
  hospital          Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  categoryId        String
  category          LabCategory    @relation(fields: [categoryId], references: [id])
  name              String
  code              String
  price             Decimal        @db.Decimal(10, 2)
  sampleType        String
  turnaroundHours   Int            @default(24)
  referenceRangeMin Decimal?       @db.Decimal(10, 2)
  referenceRangeMax Decimal?       @db.Decimal(10, 2)
  unit              String?

  orderItems        LabOrderItem[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([hospitalId, code])
}

model LabOrder {
  id            String           @id @default(uuid())
  hospitalId    String
  hospital      Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  encounterId   String
  encounter     PatientEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  orderDate     DateTime         @default(now())
  status        LabOrderStatus   @default(ORDERED)
  clinicalNotes String?

  items         LabOrderItem[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([hospitalId, patientId])
}

model LabOrderItem {
  id                 String         @id @default(uuid())
  orderId            String
  order              LabOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  testId             String
  test               LabTest        @relation(fields: [testId], references: [id])
  status             LabOrderStatus @default(ORDERED)
  resultValue        String?
  isAbnormal         Boolean        @default(false)
  referenceRangeText String?
  technicianNotes    String?
  collectedAt        DateTime?
  completedAt        DateTime?
  approvedByUserId   String?
  approvedAt         DateTime?
  reportPdfUrl       String?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([orderId])
}

// ------------------------------------------------------------------------------
// BILLING & PAYMENTS
// ------------------------------------------------------------------------------

model Invoice {
  id             String            @id @default(uuid())
  hospitalId     String
  hospital       Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId  String?           @unique
  appointment    Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  encounterId    String?           @unique
  encounter      PatientEncounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  invoiceNumber  String
  subtotal       Decimal           @db.Decimal(12, 2)
  taxAmount      Decimal           @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal           @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal           @db.Decimal(12, 2)
  paidAmount     Decimal           @default(0.00) @db.Decimal(12, 2)
  status         InvoiceStatus     @default(DRAFT)
  dueDate        DateTime?

  items          InvoiceItem[]
  payments       Payment[]

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([hospitalId, invoiceNumber])
  @@index([hospitalId, patientId])
}

model InvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type        InvoiceItemType @default(CONSULTATION)
  itemId      String?
  description String
  quantity    Int             @default(1)
  unitPrice   Decimal         @db.Decimal(10, 2)
  totalPrice  Decimal         @db.Decimal(10, 2)

  createdAt   DateTime        @default(now())

  @@index([invoiceId])
}

model Payment {
  id                   String        @id @default(uuid())
  hospitalId           String
  invoiceId            String
  invoice              Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount               Decimal       @db.Decimal(12, 2)
  method               PaymentMethod @default(CASH)
  status               PaymentStatus @default(PENDING)
  transactionReference String?
  gatewayResponseJson  Json?
  paidAt               DateTime?

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([hospitalId, invoiceId])
}

// ------------------------------------------------------------------------------
// NOTIFICATIONS & AUDIT LOGS
// ------------------------------------------------------------------------------

model Notification {
  id           String              @id @default(uuid())
  hospitalId   String?
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  message      String
  channel      NotificationChannel @default(IN_APP)
  status       NotificationStatus  @default(PENDING)
  metadataJson Json?
  readAt       DateTime?

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId, status])
}

model AuditLog {
  id          String      @id @default(uuid())
  hospitalId  String?
  hospital    Hospital?   @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      AuditAction
  entityName  String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  changesJson Json?

  createdAt   DateTime    @default(now())

  @@index([hospitalId, entityName])
  @@index([userId, createdAt])
}
