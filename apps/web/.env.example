# ==============================================================================
# MedCore HMS — Frontend Web Environment Configuration Template (apps/web)
# Copy this file to apps/web/.env.local for local frontend execution.
# NEVER commit real production secrets into version control.
# ==============================================================================

# Backend API Endpoint
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Auth Configuration (Client-side / Browser safe)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"

# Firebase Client Configuration (Firebase Hosting)
NEXT_PUBLIC_FIREBASE_API_KEY="[YOUR-FIREBASE-API-KEY]"
NEXT_PUBLIC_FIREBASE_APP_ID="[YOUR-FIREBASE-APP-ID]"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="[YOUR-FIREBASE-MEASUREMENT-ID]"
