# ==============================================================================
# MedCore HMS — Root Environment Configuration Template
# Copy this file to .env and configure your local or hosted service credentials.
# NEVER commit .env into source control.
# ==============================================================================

# Node Environment & Server Ports
NODE_ENV=production
PORT=3001
FRONTEND_PORT=3000

# Database Configuration (PostgreSQL 16 / Supabase)
# For Supabase Session Mode or PgBouncer Transaction Mode (Port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@[YOUR-DB-HOST]:5432/postgres?connection_limit=10&pool_timeout=45&schema=public"
# Direct database URL for running migrations if pooler is used
DIRECT_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@[YOUR-DB-HOST]:5432/postgres?schema=public"

# Redis 7 & BullMQ Background Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# Supabase Auth & Project Configuration
# PUBLIC (Safe for browser / frontend)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
# PRIVATE (Server-side API only)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"

# S3-Compatible Object Storage (AWS S3 / MinIO / Cloudflare R2)
S3_REGION=ap-south-1
S3_BUCKET=medcore-storage-bucket
S3_ACCESS_KEY_ID="[YOUR-S3-ACCESS-KEY-ID]"
S3_SECRET_ACCESS_KEY="[YOUR-S3-SECRET-ACCESS-KEY]"
# Optional S3 Endpoint (Required for MinIO, e.g. http://localhost:9000)
S3_ENDPOINT=

# Security & Session Token Configuration
# Generate secure 256-bit secrets via: openssl rand -base64 32
JWT_ACCESS_SECRET="[GENERATE-SECURE-ACCESS-SECRET]"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="[GENERATE-SECURE-REFRESH-SECRET]"
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET="[GENERATE-SECURE-COOKIE-SECRET]"

# CORS & Frontend Origins
CORS_ORIGINS="http://localhost:3000,https://[YOUR-FIREBASE-APP].web.app"

# Application URLs
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment Gateway Integrations (Stripe / Razorpay)
STRIPE_SECRET_KEY="[STRIPE-SECRET-KEY]"
STRIPE_WEBHOOK_SECRET="[STRIPE-WEBHOOK-SECRET]"
RAZORPAY_KEY_ID="[RAZORPAY-KEY-ID]"
RAZORPAY_KEY_SECRET="[RAZORPAY-KEY-SECRET]"

# Notification Delivery Services (Email & SMS)
RESEND_API_KEY="[RESEND-API-KEY]"
EMAIL_FROM="MedCore HMS <no-reply@medcorehms.local>"
TWILIO_ACCOUNT_SID="[TWILIO-ACCOUNT-SID]"
TWILIO_AUTH_TOKEN="[TWILIO-AUTH-TOKEN]"
TWILIO_PHONE_NUMBER="+1234567890"

# Firebase Client Configuration (Firebase Hosting)
NEXT_PUBLIC_FIREBASE_API_KEY="[YOUR-FIREBASE-API-KEY]"
NEXT_PUBLIC_FIREBASE_APP_ID="[YOUR-FIREBASE-APP-ID]"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="[YOUR-FIREBASE-MEASUREMENT-ID]"

# Observability (Optional)
SENTRY_DSN=
