# ==============================================================================
# MedCore HMS — Environment Configuration
# Copy this file to .env and configure your local or hosted service credentials.
# NEVER commit .env into source control.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3001
FRONTEND_PORT=3000

# Database Configuration (PostgreSQL 16)
# Local Docker or Cloud Provider (Neon / Supabase / AWS RDS)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/medcore_hms?schema=public"

# Redis Configuration (Redis 7)
# Local Docker or Cloud Provider (Upstash / ElastiCache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# Security & Authentication
# Generate strong 256-bit keys using: openssl rand -base64 32
JWT_ACCESS_SECRET=medcore_hms_access_super_secret_key_change_in_production_2025
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=medcore_hms_refresh_super_secret_key_change_in_production_2025
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=medcore_cookie_secret_key_change_in_production_2025

# CORS Configuration
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Frontend Application URL
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment Gateways (Test Mode)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
RAZORPAY_KEY_ID=rzp_test_placeholder_id
RAZORPAY_KEY_SECRET=placeholder_secret

# Notification Providers (Test Mode)
RESEND_API_KEY=re_placeholder_key
EMAIL_FROM="MedCore HMS <no-reply@medcorehms.local>"
TWILIO_ACCOUNT_SID=AC_placeholder_sid
TWILIO_AUTH_TOKEN=placeholder_token
TWILIO_PHONE_NUMBER=+1234567890

# S3 / Object Storage (Medical Document Attachments)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder_access_key
AWS_SECRET_ACCESS_KEY=placeholder_secret_key
AWS_S3_BUCKET_NAME=medcore-hms-attachments

# Sentry Monitoring
SENTRY_DSN=
